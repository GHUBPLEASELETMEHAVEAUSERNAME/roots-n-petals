# Set this as AUTHOR_KEY_CODE in your local .env file and Vercel project settings.
AUTHOR_KEY_CODE=replace-with-a-long-private-code
# Keep this private server-side code in your local .env and Vercel project settings.
AUTO_MODE_CODE=replace-with-a-private-code
# Optional private phrase that completes the active puzzle immediately.
PUZZLE_COMPLETE_CODE=replace-with-a-private-code
# Optional phrase that counts as solving only the currently open question.
QUESTION_SOLVE_CODE=replace-with-a-private-code
# Phrase that returns the available gameplay and answer-key codeword list.
CODE_LIST_CODE=replace-with-a-private-code
# Optional phrase that starts a fresh puzzle at the current difficulty.
PUZZLE_RESTART_CODE=replace-with-a-private-code
# Optional phrase and display text for the on-screen word effect.
SCREEN_EFFECT_CODE=replace-with-a-private-code
SCREEN_EFFECT_TEXT=WORDS
# For Vercel or a clean source copy without the ignored local file, add ANSWER_KEY_JSON
# and paste the contents of server/answerKey.private.json.
ANSWER_KEY_JSON=
